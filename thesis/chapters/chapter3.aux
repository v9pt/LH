\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Detailed recovery of thin-rimmed eyeglasses. Traditional CNN models often blur these structures into the skin. Our locality-constrained approach utilizes dictionary atoms containing sharp edge priors to maintain the geometric integrity of the eyewear.}}{39}{figure.caption.26}\protected@file@percent }
\newlabel{fig:gallery2}{{3.8}{39}{Detailed recovery of thin-rimmed eyeglasses. Traditional CNN models often blur these structures into the skin. Our locality-constrained approach utilizes dictionary atoms containing sharp edge priors to maintain the geometric integrity of the eyewear}{figure.caption.26}{}}
